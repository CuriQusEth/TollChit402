# Ödemeleri imzalayan cüzdanın private key'i (0x + 64 hane).
#
# UYARI: Bu bir "sıcak cüzdan"dır. Ajan aracı her çağırdığında, insan onayı
# istenmeden buradan ödeme yapılır. Yalnızca gözden çıkarabileceğiniz küçük bir
# USDC bakiyesi tutun; ana cüzdanınızın anahtarını asla buraya koymayın.
EVM_PRIVATE_KEY=

# Ödeme yapılacak x402 endpoint'i. Boş bırakılırsa bu projenin dağıtımı kullanılır.
RESOURCE_SERVER_URL=https://x402-pay-iota.vercel.app/api/premium

# İsteğe bağlı: ödemelerin gideceği Base adresi. Araç çağrısındaki `recipient`
# parametresi bunu tek seferlik geçersiz kılar.
PAYMENT_RECIPIENT=
