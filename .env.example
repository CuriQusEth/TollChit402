# Bu proje tarayıcı cüzdanıyla (wagmi) ödeme yapar; private key SUNUCUDA TUTULMAZ.

# CDP Facilitator kimlik bilgileri (https://portal.cdp.coinbase.com).
# Ödemeleri doğrular ve Base üzerinde settle eder.
# Biçim: organizations/<org-uuid>/apiKeys/<key-uuid> ya da yalnızca <key-uuid>.
# CDP portalı etiketleri tarayıcı diline göre çevirir ("kuruluşlar/..." gibi);
# çevrilmiş bir değer yapıştırırsanız otomatik düzeltilir.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# İsteğe bağlı: arayüzdeki "Recipient Address" alanı boş bırakıldığında
# ödemelerin (USDC) gideceği Base adresi. Panel doldurulursa o adres kazanır.
PAYMENT_RECIPIENT_ADDRESS=

# İsteğe bağlı: ERC-8021 Base Builder Code (https://base.dev -> Builder Codes).
# Bu endpoint'in Base üzerindeki settlement'larını bir uygulamaya atfeder.
# Tanımlanmazsa projenin kendi kodu (bc_emd9geld) kullanılır; bir fork'u kendi
# kodunuza atfetmek için buraya yazın. Boş bırakırsanız atıf tamamen kapanır.
# 1-32 karakter; küçük harf, rakam ve alt çizgi.
# BUILDER_CODE=

# İsteğe bağlı: farklı bir facilitator (staging/canary/yerel stub) hedeflemek için.
# Boş bırakılırsa CDP prodüksiyon facilitator'ı kullanılır.
# CDP_FACILITATOR_BASE_URL=

# İsteğe bağlı: Vercel KV bağlıysa ödeme sayaçları kalıcı olur. Tanımlı
# değilse sayaçlar bellekte tutulur ve her yeniden başlatmada sıfırlanır.
# Bu iki değişkeni Vercel KV entegrasyonu otomatik ekler.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- TollChit402 bilet NFT'si (isteğe bağlı) ---
# İkisi de tanımlanmazsa özellik kapalıdır ve ödemeler normal çalışır.

# TollChit402 (sembol CHIT402) kontratının Base mainnet adresi.
# Eski adı RECEIPT_CONTRACT_ADDRESS de okunur (geçiş desteği), ama yeni adı
# kullanın; eski ad ileride kaldırılacak.
# Bu projenin dağıttığı kontrat aşağıdaki adreste; kendi kopyanızı
# dağıtmak isterseniz `npm run deploy:receipt` çıktısındaki adresi yazın.
TOLLCHIT_CONTRACT_ADDRESS=0x67a3e2780345da00660D7C21905E202f6f416427

# Biletleri basan sunucu cüzdanı (kontratın sahibi).
# DİKKAT: Alıcının EIP-3009 ödemesi gazsızdır — gazı facilitator öder. Makbuz
# basımı ise gerçek bir zincir üstü yazma işlemidir ve gazını BU CÜZDAN öder.
# Base ağında küçük bir ETH bakiyesi bulundurun ve elle doldurun; bakiye
# bittiğinde basım sessizce başarısız olur, ödemeler etkilenmez.
RECEIPT_MINTER_PRIVATE_KEY=

# Sitenin KALICI adresi. Biletin görseli ve verisi buradan sunulur; kontrata
# yazılan tokenURI bu adresi gösterir.
#
# Neden önemli: bu tanımlı değilken bilet verisi (5,5 KB'lık SVG dahil) zincire
# gömülür ve basım başına ~3,6 milyon gaz tutar — 0,001 dolarlık bir ödeme için
# orantısız, üstelik bu boyuttaki işlem düğüm tarafından reddedilebilir. Adres
# tanımlıyken basım ~230 bin gaza iner.
#
# Dağıtımdan dağıtıma DEĞİŞMEYEN adresi yazın: tokenURI kontrata bir kez
# yazılır ve kontratta setTokenURI olmadığı için bir daha düzeltilemez.
# Vercel'de tanımlamazsanız VERCEL_PROJECT_PRODUCTION_URL (üretim alan adı)
# kullanılır; VERCEL_URL her dağıtımda değiştiği için bilerek kullanılmaz.
PUBLIC_BASE_URL=

# İsteğe bağlı: bilet basımı ve dağıtımın kullanacağı Base RPC adresi.
# Tanımlı değilse viem'in public RPC'si kullanılır; public uçların hız
# sınırları sıkıdır, üretimde kendi sağlayıcınızı verin.
# BASE_RPC_URL=
