# Bu proje tarayıcı cüzdanıyla (wagmi) ödeme yapar; private key SUNUCUDA TUTULMAZ.

# CDP Facilitator kimlik bilgileri (https://portal.cdp.coinbase.com).
# Ödemeleri doğrular ve Base üzerinde settle eder.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Ödemelerin (USDC) gideceği Base adresi.
PAYMENT_RECIPIENT_ADDRESS=

# İsteğe bağlı: ERC-8021 Base Builder Code (https://base.dev -> Builder Codes).
# Bu endpoint'in Base üzerindeki settlement'larını bir uygulamaya atfeder.
# Tanımlanmazsa projenin kendi kodu (bc_g6baqkul) kullanılır; bir fork'u kendi
# kodunuza atfetmek için buraya yazın. Boş bırakırsanız atıf tamamen kapanır.
# 1-32 karakter; küçük harf, rakam ve alt çizgi.
# BUILDER_CODE=

# İsteğe bağlı: farklı bir facilitator (staging/canary/yerel stub) hedeflemek için.
# Boş bırakılırsa CDP prodüksiyon facilitator'ı kullanılır.
# CDP_FACILITATOR_BASE_URL=
