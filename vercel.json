{
  "rewrites": [
    {
      "source": "/api/premium/:path*",
      "destination": "/api/premium"
    },
    {
      "source": "/api/mint-receipt",
      "destination": "/api/premium"
    },
    {
      "source": "/api/receipt-status",
      "destination": "/api/premium"
    },
    {
      "source": "/api/stats",
      "destination": "/api/premium"
    },
    {
      "source": "/.well-known/agent-card.json",
      "destination": "/api/premium"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
